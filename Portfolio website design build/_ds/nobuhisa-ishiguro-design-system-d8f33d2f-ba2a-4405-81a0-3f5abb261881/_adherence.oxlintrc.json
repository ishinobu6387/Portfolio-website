{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/layout/**",
              "image-slot.js"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:EB Garamond))/i]",
        "message": "Font not provided by the design system. Available: EB Garamond."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|onClick|disabled|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, onClick, disabled."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|outline|ghost)$/]",
        "message": "<Button> variant must be one of 'primary' | 'outline' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|href|active|key|ref|className|style|children)$/]",
        "message": "<NavLink> doesn't accept that prop. Declared props: children, href, active."
      },
      {
        "selector": "JSXOpeningElement[name.name='PageHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|tagline|key|ref|className|style|children)$/]",
        "message": "<PageHeader> doesn't accept that prop. Declared props: name, tagline."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProjectCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:image|index|title|meta|onClick|key|ref|className|style|children)$/]",
        "message": "<ProjectCard> doesn't accept that prop. Declared props: image, index, title, meta, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionLabel'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|inverse|key|ref|className|style|children)$/]",
        "message": "<SectionLabel> doesn't accept that prop. Declared props: children, inverse."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|key|ref|className|style|children)$/]",
        "message": "<Tag> doesn't accept that prop. Declared props: children."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {
      "Button": {
        "replaces": []
      },
      "NavLink": {
        "replaces": []
      },
      "PageHeader": {
        "replaces": []
      },
      "ProjectCard": {
        "replaces": []
      },
      "SectionLabel": {
        "replaces": []
      },
      "Tag": {
        "replaces": []
      }
    },
    "tokens": [
      "--accent",
      "--ash",
      "--black",
      "--border-default",
      "--border-subtle",
      "--border-w",
      "--border-w-thick",
      "--charcoal",
      "--container-max",
      "--duration",
      "--duration-fast",
      "--ease",
      "--fog",
      "--font-display",
      "--font-serif",
      "--fs-body",
      "--fs-caption",
      "--fs-display-1",
      "--fs-display-2",
      "--fs-h1",
      "--fs-h2",
      "--fs-h3",
      "--fs-label",
      "--fs-quote",
      "--gutter",
      "--ink",
      "--lh-body",
      "--lh-heading",
      "--lh-quote",
      "--lh-tight",
      "--line",
      "--paper",
      "--radius",
      "--space-1",
      "--space-10",
      "--space-2",
      "--space-3",
      "--space-4",
      "--space-5",
      "--space-6",
      "--space-7",
      "--space-8",
      "--space-9",
      "--stone",
      "--surface-card",
      "--surface-inverse",
      "--surface-page",
      "--text-inverse",
      "--text-muted",
      "--text-primary",
      "--text-secondary",
      "--tracking-mid",
      "--tracking-tight",
      "--tracking-wide",
      "--white"
